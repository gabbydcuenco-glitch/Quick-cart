flowchart TB
    subgraph HOST["Host / Developer Machine"]
        DEV["Developer<br/>(VS Code + git push)"]
    end

    GH[("GitHub<br/>Repository")]
    NGROK["ngrok tunnel<br/>(for the webhook)"]

    subgraph JNET["infra/jenkins (Separate Docker Compose)"]
        JENKINS["jenkins<br/>Jenkins LTS + Docker CLI<br/>Port 8080 → published 8081"]
        JHOME[("jenkins_home<br/>Named Volume")]
    end

    SOCK["Host Docker Engine<br/>(/var/run/docker.sock)"]

    subgraph APPSTACK["quickcart stack (docker-compose.yml)"]
        APP["proxy + frontend + catalog-api +<br/>order-api + payment-api + db<br/>(image tag = BUILD_NUMBER)"]
    end

    DEV -- "git push" --> GH
    GH -- "A. Webhook (instant)" --> NGROK
    NGROK --> JENKINS
    JENKINS -- "B. Poll SCM every 2 min" --> GH
    JENKINS --- JHOME
    JENKINS -- "Test → Build Images →<br/>Deploy → Smoke Test" --> SOCK
    SOCK -- "docker compose up -d" --> APP

    classDef box fill:#ffffff,stroke:#22223b,stroke-width:2px,color:#22223b
    class DEV,GH,NGROK,JENKINS,JHOME,SOCK,APP box
    style HOST fill:#fdf0ff,stroke:#d77fe8,stroke-width:2px
    style JNET fill:#fff8e6,stroke:#e0a526,stroke-width:2px
    style APPSTACK fill:#effcf8,stroke:#3fcfb4,stroke-width:2px
