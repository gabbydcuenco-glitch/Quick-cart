erDiagram
    CUSTOMERS ||--o{ ORDERS : "places"
    ORDERS ||--|{ ORDER_ITEMS : "contains"
    PRODUCTS ||--o{ ORDER_ITEMS : "sold as"
    ORDERS ||--o{ ACTIVITY_LOGS : "records"

    PRODUCTS {
        int product_id PK
        varchar slug
        varchar name
        varchar category
        decimal price
        decimal list_price
        int stock
    }
    CUSTOMERS {
        int customer_id PK
        varchar email
        varchar full_name
        varchar phone
        varchar street
    }
    ORDERS {
        int order_id PK
        varchar order_number
        int customer_id FK
        varchar status
        varchar delivery_method
        decimal total
        varchar payment_reference
    }
    ORDER_ITEMS {
        int item_id PK
        int order_id FK
        int product_id FK
        varchar product_name
        decimal unit_price
        int quantity
    }
    ACTIVITY_LOGS {
        int log_id PK
        int order_id FK
        varchar action_type
        text info
    }
    SUPPORT_TICKETS {
        int ticket_id PK
        varchar name
        varchar email
        varchar subject
        text message
    }
