{
  "name": "quickcart",
  "private": true,
  "scripts": {
    "test:startup": "node --test scripts/database-env.test.js scripts/docker-required.test.js scripts/docker-images.test.js scripts/network.test.js",
    "doctor": "node scripts/doctor.js",
    "postinstall": "node scripts/ensure-frontend.js",
    "predev": "node scripts/prepare-dev.js && node scripts/ensure-frontend.js",
    "predev:https": "node scripts/prepare-dev.js && node scripts/ensure-frontend.js",
    "dev": "npm --prefix frontend run dev",
    "start": "node scripts/prepare-dev.js",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "test": "docker build --target test ./catalog-api && docker build --target test ./order-api && docker build --target test ./payment-api && docker build --target test ./frontend",
    "db": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "jenkins": "docker compose -p quickcart-jenkins -f infra/jenkins/docker-compose.yml up -d --build",
    "dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f frontend",
    "dev:containers": "node scripts/prepare-dev.js --dev",
    "backend": "node scripts/prepare-dev.js",
    "install:frontend": "npm --prefix frontend ci",
    "https:setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/Setup-LocalHttps.ps1",
    "setup:dev": "node scripts/prepare-dev.js --build",
    "dev:https": "npm --prefix frontend run dev -- --mode https",
    "repair:env": "node scripts/init-env.js",
    "verify": "pwsh -NoProfile -File scripts/Verify-QuickCart.ps1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
